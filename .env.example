# Copy to .env (never commit .env). Everything is optional in local development:
# the defaults work with `npm run dev`. In production (NODE_ENV=production) the server
# refuses to start until JWT_SECRET, CODE_PEPPER and ENCRYPTION_KEY are set to real secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (e.g. 1 behind an ALB), so rate limits see real client IPs.
TRUST_PROXY=0

# --- Data stores -------------------------------------------------------------
# MongoDB replica set (transactions are required). Default targets `npm run dev:db`.
MONGO_URI=mongodb://127.0.0.1:27017/soccer_voting?directConnection=true

# Leave empty for the in-memory Redis fallback (single process, data lost on restart).
# Set for a real server, e.g. redis://localhost:6379 (Memurai) or ElastiCache in AWS.
REDIS_URL=

# Leave S3_BUCKET empty to store candidate images on local disk under DATA_DIR.
DATA_DIR=./.data
S3_BUCKET=
S3_REGION=us-east-1
# Only for S3-compatible services; leave empty for AWS S3.
S3_ENDPOINT=
# Leave empty on AWS to use the task role.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Secrets (generate unique values for every environment) -------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Keys the HMAC used for verification codes and national IDs. Changing it invalidates existing codes.
CODE_PEPPER=
# 64 hex chars (32 bytes) for AES-256-GCM (encrypts admin TOTP secrets).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- First admin (used by `npm run seed`) -------------------------------------
ADMIN_EMAIL=
# At least 12 characters.
ADMIN_PASSWORD=
